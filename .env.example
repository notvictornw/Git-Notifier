# Git Notifier - Environment Variables
# Copy relevant values into your environment, .env loader, or hosting platform.
# For full configuration, prefer config.yml (see config.yml.example).

# --- Required ---
# Webhook secret: must match the secret configured in GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# --- Optional: GitHub API (enrichment, digest, health dashboard) ---
# Use a PAT/fine-grained token OR GitHub App credentials below.
GITHUB_TOKEN=
# GH_TOKEN=
# GITHUB_API_BASE=https://api.github.com
# GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# GitHub App (alternative to token)
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- Optional: Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: config loading ---
# CONFIG_PATH=./config.yml
# CONFIG_YML_CONTENT=  # Full YAML config as a single env var (useful in PaaS)
